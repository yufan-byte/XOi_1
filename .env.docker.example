# ===== XOi 部署环境变量示例（复制为 .env 后修改）=====

# ---------- 服务 ----------
# 宿主机对外端口；若被占用可改如 8080，再用 Nginx 反代到域名
PORT=10588

# ---------- 管理员引导（v3.0 起语义已变）----------
# 改造后 new-api 是账号的唯一权威，本地 o_user 只是镜像表（o_user.id == newapi uid）。
# 因此这里不再需要密码：管理员的判定跟随网关 role >= 10。
# 若要提前占位一条本地管理员行，填 new-api 里站长的 uid（不知道就留空）。
# XOI_BOOTSTRAP_ADMIN_UID=
# XOI_BOOTSTRAP_ADMIN_NAME=admin

# ---------- new-api 网关（v3.0 新增，必填）----------
# XOi 加入 new-api Compose 已有的 Docker 网络；`docker network ls` 可查看。
NEWAPI_DOCKER_NETWORK=ops_default

# new-api 站点地址（容器内必须用服务别名，不能写 127.0.0.1）
NEWAPI_BASE_URL=http://new-api:3000

# 管理员访问令牌：只用于注册、用户管理和额度调整，不用于模型推理。
# 模型推理会在服务端使用当前用户的专属令牌，由 new-api 直接扣用户额度。
NEWAPI_ADMIN_TOKEN=

# 生产强制所有模型调用经过 NewAPI（建议保持 1）
XOI_NEWAPI_ONLY=1

# 团队模式；设为 0 可临时禁止新建团队（已有团队数据不删除）
XOI_TEAM_ENABLED=1

# 注册欢迎额度（new-api quota 单位：500000 = ¥1）。默认 0 = 不赠送。
# NEWAPI_WELCOME_QUOTA=0

# 与 new-api 完全相同的 PostgreSQL（XOi 业务表也在这个库）。
# 容器内使用数据库服务别名，例如 postgres；请替换密码。
NEWAPI_DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/new-api

# 网关请求超时（毫秒）
# NEWAPI_TIMEOUT_MS=15000

# ---------- 其它 ----------
# 数据目录（默认 ./data）
# XOI_DATA_DIR=./data

# OSS 对外访问前缀（默认走本地服务地址 /oss）
# ossURL=

# 允许的跨域来源（逗号分隔，留空=允许全部）
# XOI_ALLOWED_ORIGINS=

# 反向代理层数（Caddy/Nginx 前置时设置，用于取真实客户端 IP）
# XOI_TRUST_PROXY=1
