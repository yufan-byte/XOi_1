{
    "name": "xoi-console",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "XOi 控制台：登录/注册页（照搬造物引擎设计，品牌为 XOi）+ 后续管理后台",
    "scripts": {
        "prebuild": "node ../scripts/sync-platform-brand.mjs --check",
        "dev": "bash ../../start.sh --skip-docker",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "build:one-stop": "tsc --noEmit -p tsconfig.one-stop.json && vite build --config vite.one-stop.config.ts",
        "dev:one-stop": "vite --config vite.one-stop.config.ts",
        "preview": "bash ../../start.sh --skip-docker"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@react-three/fiber": "^9.3.0",
        "@tanstack/react-query": "^5.100.9",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.548.0",
        "qrcode": "^1.5.4",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.12.0",
        "remark-gfm": "^4.0.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "three": "^0.180.0",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/qrcode": "^1.5.6",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "@types/three": "^0.180.0",
        "@vitejs/plugin-react": "^5.2.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5",
        "vite": "^7.3.0"
    }
}
