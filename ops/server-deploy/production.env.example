# Copy to /opt/xoi/deploy/.env and chmod 600. Never commit real values.
# Example tags are placeholders, NOT a release certification. Pin tested digests before production.
XOI_IMAGE=xoi:20261017-r1
# Must identify the exact verified image build. Passed to docker build --build-arg.
# Do not relabel a running old image as a newer release via environment overrides.
XOI_RELEASE_ID=20261017-r1
POSTGRES_IMAGE=postgres:16-alpine
NEWAPI_IMAGE=calciumion/new-api:PIN_TESTED_VERSION

# Use independently generated hexadecimal secrets to avoid URI/interpolation escaping problems.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_DATABASE_PASSWORD
NEWAPI_SESSION_SECRET=REPLACE_WITH_RANDOM_HEX_SESSION_SECRET
NEWAPI_CRYPTO_SECRET=REPLACE_WITH_RANDOM_HEX_CRYPTO_SECRET

# This is an initialization guard, not the password used to log into NewAPI.
XOI_ADMIN_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_HEX_PASSWORD

# Fill after NewAPI initialization / migration. Not the Zaowu upstream channel key.
# This temporary placeholder allows starting only postgres/new-api; do not start xoi with it.
NEWAPI_ADMIN_TOKEN=REPLACE_AFTER_GATEWAY_INITIALIZATION
NEWAPI_ADMIN_USER=1

# Replace with the actual domain (no trailing slash). Never publish this placeholder domain.
XOI_ALLOWED_ORIGINS=https://studio.example.com
# Fill with the verified Docker-side source IP of the host Nginx; never use true or '*'.
XOI_TRUST_PROXY=

# Empty selects the enabled channel tagged zaowu-all.
XOI_UPSTREAM_CHANNEL_ID=
# Must match the REAL billing group of the Zaowu channel key; do not assume it is default.
XOI_UPSTREAM_BILLING_GROUP=default

# Leave payments disabled until callback verification and payment acceptance are complete.
XOI_PAY_NOTIFY_HOST=
# 正式多用户部署使用 PostgreSQL。旧部署必须先停写、迁移并核对；原文件保留。
# files 仅为显式的单进程兼容模式，不能用于多副本。
XOI_CANVAS_STORAGE=postgres
XOI_RELEASE_ROLLOUT_ENABLED=0
XOI_INSTANCE_LABEL=xoi-node
XOI_RELEASE_START_MODE=active
XOI_RELEASE_CLUSTER=xoi-prod
# 全新安装留 empty（跳过旧站 reseller.json 迁移校验）；从旧站迁移请先迁移再删掉此行
XOI_SITE_CONFIG_BOOTSTRAP=empty
