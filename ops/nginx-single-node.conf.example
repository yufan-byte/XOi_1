# Install inside nginx http {} (e.g. /etc/nginx/conf.d/xoi.conf).
# Replace domain and TLS files. First provision certificates before enabling TLS.
# Only one application upstream is safe with the current in-memory/local-file state.
# In the MAIN nginx.conf (not this http{} snippet), start capacity validation with:
# worker_processes auto;
# worker_rlimit_nofile 65535;
# events { worker_connections 8192; }
# Match the systemd LimitNOFILE/container ulimit. These are starting limits, not a 2000-user certificate.
# Nginx worker_connections counts client AND proxied upstream connections.
map $http_upgrade $xoi_connection_upgrade {
    default upgrade;
    ''      '';
}
upstream xoi_single_node {
    server 127.0.0.1:12121;
    keepalive 64;
}
server {
    listen 80;
    server_name studio.example.com;
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name studio.example.com;
    ssl_certificate /etc/letsencrypt/live/studio.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/studio.example.com/privkey.pem;
    client_max_body_size 100m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    # Do not add a shared proxy cache for /api or private /oss user media.
    location / {
        proxy_pass http://xoi_single_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # This example is the edge proxy: overwrite untrusted client XFF.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $xoi_connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off; # preserve SSE/AI streaming; no auth response caching
    }
}
