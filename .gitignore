# 依赖
node_modules/
.pnp
.pnp.js

# 本地开发用的 PostgreSQL 数据目录（scripts/dev-pg.sh 用，别提交）
.local/

# 构建产物
dist/
build/
data/serve/
*.tgz

# 环境变量（除示例模板外，所有 .env.* 变体都不入库；.env.production/.env.staging 曾漏掉）
.env
.env.local
.env.*.local
.env.*
!.env.example
!.env.docker.example

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# 测试覆盖率
coverage/

# Electron
release/
dist-electron/

# SQLite 数据库文件
*.db
*.sqlite
*.sqlite3

# 临时文件
tmp/
temp/

# 上传文件
uploads/

# 构建缓存
.cache/
*.tsbuildinfo

# 构建产物
frontend/vite.config.js
frontend/vite.config.d.ts
backend/data/*.bak

# 运行时数据（画布内容为用户创作数据，不提交仓库）
backend/data/canvases/

# 部署打包产物（宝塔部署包）
deploy/

# 本地运行态（start.sh / stop.sh 写的 pid，不进仓库）
.xoi-run/
*.pid

# Python 工具脚本的字节码缓存
__pycache__/
*.pyc

# 购买的完整技能包由本地导入，部署时单独同步。
backend/data/skills/purchased/

# 内部工作区（记忆/身份/SOUL 等，绝不可入库）
.workbuddy/

# npm 缓存与本地镜像配置（本地开发环境相关，不入库）
.npm-cache/
frontend/.npm-cache/
frontend/atelier/.npm-cache/
.npmrc

# 前端构建发布产物（部署时由 sync 脚本生成，不入库；当前约 3.1G）
backend/data/web/

# 用户生成的媒体文件（运行时落盘内容，不入库；当前约 427M）
backend/data/media/

# 验收/联调的运行时产物（acceptance 视频+json，不入库）
backend/data/acceptance/
