# XOi 后端环境变量示例（复制为 .env 后按需修改）

# 服务端口（默认 10588）
# PORT=10588

# 管理员账号（仅首次初始化数据库时生效）
# XOI_ADMIN_USERNAME=admin
# XOI_ADMIN_PASSWORD=admin123

# 数据目录（默认 ./data）
# XOI_DATA_DIR=./data

# OSS 对外访问前缀（默认走本地服务地址 /oss）
# ossURL=

# 生产环境 NODE_ENV=prod 时会强制走数据目录初始化并警告默认口令

# =====================================================================
# new-api 模型网关（v3.0 起：账号 / 额度 / 日志的唯一权威）
# =====================================================================
# 这三项原示例里一个都没写，等于部署时必然漏配，这里补齐。

# 1) 业务库：**必须与 new-api 同库**（决策 D2）
#    PostgreSQL 连接串。两个变量名都认，优先使用 NEWAPI_DATABASE_URL。
#    不配的话进程能起来，但所有数据库读写都会失败。
# NEWAPI_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/new-api
# NEWAPI_PG_URL=postgres://postgres:postgres@127.0.0.1:5432/new-api

# 2) 网关 HTTP 地址（登录 / 注册 / 额度调整 / 分组倍率都走它）
# NEWAPI_BASE_URL=http://127.0.0.1:3000

# 3) 管理员令牌（服务端专用，绝不下发浏览器）
# NEWAPI_ADMIN_TOKEN=

# 生产默认开启：禁用其它供应商，所有推理必须经过 NewAPI。
# XOI_NEWAPI_ONLY=1

# 团队模式（默认开启）。团队成员是真实 NewAPI 账号，额度从主账号团队池划拨。
# XOI_TEAM_ENABLED=1

# 网关请求超时（毫秒）
# NEWAPI_TIMEOUT_MS=15000
