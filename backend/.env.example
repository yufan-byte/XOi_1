# XOi 后端环境变量示例（复制为 .env 后按需修改）

# 服务端口（XOi 独立默认端口）
# PORT=12121
# 生产镜像内的不可变程序目录；本地开发不填。
# XOI_RELEASE_DIR=/app/release
# 公开版本标签，不包含密钥、路径或内部配置。
# XOI_RELEASE_ID=20261017-r1

# 管理员账号（仅首次初始化数据库时生效）
# XOI_ADMIN_USERNAME=admin
# XOI_ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters

# 数据目录（默认 ./data）
# XOI_DATA_DIR=./data

# 画布存储：生产默认 postgres，开发默认 files；旧部署须先停写迁移并验证。
# 新的空部署可直接用 postgres；多实例共享数据库时必须使用 postgres。
# 迁移命令与回滚注意事项见 docs/画布数据库迁移-2026-10-17.md。
# XOI_CANVAS_STORAGE=postgres
# 发布中心默认只监控。完成多节点/共享媒体/会话/负载均衡验收后才可开放摘流。
# 即使开启，没有健康替代节点也会拒绝摘流；不会执行服务器命令或安装代码。
# XOI_RELEASE_ROLLOUT_ENABLED=0
# XOI_INSTANCE_LABEL=xoi-blue
# 新候选节点可用 standby 启动：不接业务请求、不领取媒体任务，超级管理员核验后恢复接流。
# XOI_RELEASE_START_MODE=active
# 同一业务的蓝绿节点使用相同部署组；不同部署/租户/环境必须不同。
# XOI_RELEASE_CLUSTER=xoi-prod

# OSS 对外访问前缀（默认走本地服务地址 /oss）
# ossURL=
# URL-only video providers need the public HTTPS origin of this XOi deployment.
# Never use localhost/internal IPs. Local Agnes base64 references do not need this.
# XOI_PUBLIC_BASE_URL=https://studio.example.com
# Server MP4 composition / tail-frame extraction: install ffmpeg (includes ffprobe).
# XOI_FFMPEG_PATH=/usr/bin/ffmpeg
# XOI_FFPROBE_PATH=/usr/bin/ffprobe

# 生产环境 NODE_ENV=prod 时会强制走数据目录初始化并警告默认口令

# =====================================================================
# new-api 模型网关（v3.0 起：账号 / 额度 / 日志的唯一权威）
# =====================================================================
# 这三项原示例里一个都没写，等于部署时必然漏配，这里补齐。

# 1) 业务库：**必须与 new-api 同库**（决策 D2）
#    PostgreSQL 连接串。两个变量名都认，优先使用 NEWAPI_DATABASE_URL。
#    不配的话进程能起来，但所有数据库读写都会失败。
# NEWAPI_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/new-api
# NEWAPI_PG_URL=postgres://postgres:postgres@127.0.0.1:5432/new-api
# 全新生产安装且没有旧 reseller.json 才显式设 empty；升级已有站点不要设置。
# XOI_SITE_CONFIG_BOOTSTRAP=empty

# 2) 网关 HTTP 地址（登录 / 注册 / 额度调整 / 分组倍率都走它）
# NEWAPI_BASE_URL=http://127.0.0.1:3000

# 造物渠道：默认自动查找 tag=zaowu-all。每 15 分钟同步成本价和模型，保留本站加价倍率。
# XOI_UPSTREAM_CHANNEL_ID=2
# XOI_UPSTREAM_BILLING_GROUP=default
# 私有分组未出现在上游公开 group_ratio 时，显式固定进货倍率；不要猜测或复用零售价倍率。
# XOI_UPSTREAM_GROUP_RATIOS={"xoi":1}
# XOI_UPSTREAM_PRICE_SYNC=0  # 只在需要暂停同步时设置为 0

# 3) 管理员令牌（服务端专用，绝不下发浏览器）
# NEWAPI_ADMIN_TOKEN=

# 生产安全门禁：必须是精确 HTTPS origin（不能使用 *）
# XOI_ALLOWED_ORIGINS=https://studio.example.com
# 仅信任实际入口 Nginx 的 IP / CIDR，不要无条件 trust proxy=true
# XOI_TRUST_PROXY=loopback
# 网关必须先关闭 BATCH_UPDATE_ENABLED 并核实；这个声明不会替你更改网关。
# XOI_NEWAPI_QUOTA_MODE=sync
# 若网关配置了 Redis，而团队/代理仍直接改 quota，目前禁止此组合上线。
# XOI_NEWAPI_REDIS_ENABLED=0
# 全站/单用户模型请求并发，与2000人同时在线不是同一件事。
# XOI_MODEL_GLOBAL_CONCURRENCY=32
# XOI_MODEL_USER_CONCURRENCY=3
# XOI_MEDIA_GLOBAL_CONCURRENCY=64
# XOI_MEDIA_USER_CONCURRENCY=6
# 裸 PG 代理/团队池，另加业务 knex 池；多实例必须算连接总额。
# XOI_AGENT_DB_POOL_MAX=8

# 生产默认开启：禁用其它供应商，所有推理必须经过 NewAPI。
# XOI_NEWAPI_ONLY=1

# 团队模式（默认开启）。团队成员是真实 NewAPI 账号，额度从主账号团队池划拨。
# XOI_TEAM_ENABLED=1

# 网关请求超时（毫秒）
# NEWAPI_TIMEOUT_MS=15000

# 每个 XOi 实例的业务连接池；所有实例与 NewAPI 的连接数之和应小于 PostgreSQL 上限
XOI_DB_POOL_MAX=8
XOI_DB_ACQUIRE_TIMEOUT_MS=10000
# 正式支付回调的 HTTPS origin；未配置时生产不开放真实支付渠道。
# XOI_PAY_NOTIFY_HOST=https://studio.example.com
# Persistent canvas media queue. Limits are safety defaults, not a capacity promise.
# Per-process workers; global/user execution limits remain shared in PostgreSQL.
XOI_MEDIA_WORKERS=4
XOI_MEDIA_QUEUE_GLOBAL_LIMIT=128
XOI_MEDIA_QUEUE_USER_LIMIT=8
